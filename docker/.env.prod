# Deployment template for ci-cd/cd.yml. Committed with placeholders only.
# The CD pipeline fills the placeholders from pipeline variables in the deploy copy;
# never put real values in this file.

POSTGRES_USER=__DB_USER__
POSTGRES_PASSWORD=__DB_PASSWORD__
POSTGRES_DB=__DB_NAME__

WEB_PORT=__WEB_PORT__
SEQ_PORT=5341

WEB_UI_API_KEY=__WEB_UI_API_KEY__
EXTERNAL_SYSTEM_API_KEY=__EXTERNAL_SYSTEM_API_KEY__

ASPNETCORE_ENVIRONMENT=Production
