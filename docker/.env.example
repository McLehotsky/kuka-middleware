# Copy to docker/.env and fill in real values. docker/.env is git-ignored – never commit it.

# PostgreSQL (used by the postgres container and to build the API connection string)
POSTGRES_USER=kuka
# Must not contain ';' (it is inserted into the Npgsql connection string) or '$' (Compose interpolates it).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kuka_middleware

# Host port of the web UI (nginx). The API and PostgreSQL are not published to the host.
WEB_PORT=8080

# Independent 32-byte lowercase hex keys. start.bat generates them without printing them.
WEB_UI_API_KEY=change-me
EXTERNAL_SYSTEM_API_KEY=change-me

# ASP.NET Core environment of the API: Production | Development
ASPNETCORE_ENVIRONMENT=Production
