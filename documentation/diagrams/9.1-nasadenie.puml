@startuml
skinparam shadowing false
skinparam roundCorner 9
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontColor #182338
skinparam defaultFontSize 16
skinparam titleFontSize 26
skinparam titleFontColor #182338
skinparam ArrowColor #46566D
skinparam ArrowFontColor #26364D
skinparam ArrowFontSize 14
skinparam ActivityBorderColor #7B8798
skinparam ActivityBackgroundColor #F9FBFE
skinparam ActivityDiamondBackgroundColor #F1EDFA
skinparam ActivityDiamondBorderColor #A197C4
skinparam ActivityDiamondFontSize 15
skinparam ActivityStartColor #26364D
skinparam ActivityEndColor #26364D
skinparam ActivityBarColor #46566D

skinparam NodeBorderColor #688098
skinparam DatabaseBorderColor #A38234
skinparam CloudBorderColor #6791B7
skinparam ActorBorderColor #43835A
skinparam ActorBackgroundColor #E5F6ED
skinparam StorageBorderColor #7B8798
skinparam LegendBackgroundColor #F7F9FC
skinparam LegendBorderColor #9DAABE
skinparam LegendFontSize 14
skinparam linetype polyline
left to right direction

title Nasadenie <U+2013> Docker Desktop

actor "Operátor\n(prehliadač)" as operator
actor "Externý systém\n(X-API-Key)" as external

rectangle "<b>PC s Docker Desktop</b>\n<size:14>porty iba na 127.0.0.1</size>" as pc #F7FAFE {
  rectangle "<b>web <U+2013> nginx + Vue</b>\n127.0.0.1:8080 (CD: 8081)" as web #EAF3FF
  rectangle "<b>api <U+2013> ASP.NET Core</b>" as api #EAF3FF
  rectangle "<b>postgres <U+2013> PostgreSQL 18</b>" as postgres #FFF5DA
  rectangle "<b>seq <U+2013> logy</b>\n127.0.0.1:5341" as seq #EEF2F7
  rectangle "pgdata" as pgdata #FFF5DA
  rectangle "seq-data" as seqdata #EEF2F7
}

cloud "<b>Školská VPN</b>" as vpn #F1F7FE {
  rectangle "<b>KUKA FM <U+2013> kukafm.its.fei</b>" as kuka #EAF3FF
}

operator --> web : HTTP
operator -[hidden]right-> external
external --> web : /api
web --> api : /api
api -right-> postgres : SQL
api -left-> seq : logy
api --> kuka : HTTPS cez VPN
seqdata -[hidden]-> kuka
postgres --> pgdata
seq --> seqdata

legend bottom
  <b>Legenda farieb</b>
  |<#E5F6ED>    | Aktéri |
  |<#EAF3FF>    | Aplikačné kontajnery, KUKA FM |
  |<#FFF5DA>    | Databáza a zväzok |
  |<#EEF2F7>    | Logy a zväzok |
  |<#F1F7FE>    | Sieť VPN |
endlegend
@enduml
