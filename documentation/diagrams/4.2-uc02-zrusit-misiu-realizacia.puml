@startuml
skinparam shadowing false
skinparam roundCorner 9
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontColor #182338
skinparam defaultFontSize 16
skinparam titleFontSize 26
skinparam titleFontColor #182338
skinparam ArrowColor #46566D
skinparam ArrowFontColor #26364D
skinparam ArrowFontSize 14
skinparam ActivityBorderColor #7B8798
skinparam ActivityBackgroundColor #F9FBFE
skinparam ActivityDiamondBackgroundColor #F1EDFA
skinparam ActivityDiamondBorderColor #A197C4
skinparam ActivityDiamondFontSize 15
skinparam ActivityStartColor #26364D
skinparam ActivityEndColor #26364D
skinparam ActivityBarColor #46566D

title UC2 Zrušiť misiu <U+2013> realizácia

start
:Klient: POST /api/missions/{id}/cancel;
switch (Kontrola?)
case (neplatný kľúč)
  :Technický log; <<#EEF2F7>>
  :401; <<#FDEBED>>
  stop
case (misia neexistuje)
  :AuditLog; <<#EEF2F7>>
  :404; <<#FDEBED>>
  stop
case (ukončená alebo Cancelling)
  :AuditLog; <<#EEF2F7>>
  :409; <<#FDEBED>>
  stop
case (OK)
endswitch

:missionCancel; <<#EAF3FF>>
if (KUKA FM prijala?) then (nie)
  :AuditLog; <<#EEF2F7>>
  :502, stav nezmenený; <<#FDEBED>>
  stop
else (áno)
  :Stav Cancelling + história; <<#FFF5DA>>
endif
if (Uloženie bez konfliktu?) then (nie)
  :Znova načítať misiu; <<#FFF5DA>>
  if (Misia je stále zrušiteľná?) then (áno)
    :Znova uložiť raz; <<#FFF5DA>>
  else (nie)
  endif
  if (Uložené?) then (nie)
    :AuditLog; <<#EEF2F7>>
    :409; <<#FDEBED>>
    stop
  else (áno)
  endif
else (áno)
endif
:AuditLog; <<#EEF2F7>>
:200 OK; <<#E5F6ED>>
stop
@enduml
