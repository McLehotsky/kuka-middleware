@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam defaultFontColor #14243A
skinparam ArrowColor #607590
skinparam roundCorner 12
title 3.1 Správa misií
actor "Operátor\n(webové UI)" as Operator #E5F6ED
actor "Externý systém\n(REST API)" as External #E5F6ED
actor "KUKA FM\n(podporný aktér)" as Kuka #E5F6ED
rectangle "KUKA Middleware" {
  usecase "UC1\nZadať misiu" as UC1 #EAF3FF
  usecase "UC2\nZrušiť misiu" as UC2 #EAF3FF
  usecase "UC3\nZobraziť zoznam misií" as UC3 #EAF3FF
  usecase "UC4\nZobraziť históriu stavov misie" as UC4 #EAF3FF
}
Operator -- UC1
Operator -- UC2
Operator -- UC3
Operator -- UC4
External -- UC1
External -- UC2
External -- UC3
UC1 -- Kuka
UC2 -- Kuka
legend bottom
  UC3 a UC4 čítajú len vlastnú DB. Aktuálnosť zabezpečuje UC5.
endlegend
@enduml
