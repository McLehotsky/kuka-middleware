@startuml
skinparam shadowing false
skinparam roundCorner 9
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontColor #182338
skinparam defaultFontSize 16
skinparam titleFontSize 26
skinparam titleFontColor #182338
skinparam ArrowColor #46566D
skinparam ArrowFontColor #26364D
skinparam ArrowFontSize 14
skinparam ActivityBorderColor #7B8798
skinparam ActivityBackgroundColor #F9FBFE
skinparam ActivityDiamondBackgroundColor #F1EDFA
skinparam ActivityDiamondBorderColor #A197C4
skinparam ActivityDiamondFontSize 15
skinparam ActivityStartColor #26364D
skinparam ActivityEndColor #26364D
skinparam ActivityBarColor #46566D

title Volanie KUKA FM <U+2013> realizácia

start
:Požiadavka na KUKA FM;
if (Token nastavený?) then (áno)
  :Pridať hlavičku Authorization\nstatický token · bez Bearer; <<#EEF2F7>>
else (nie: bez hlavičky)
endif
:POST /interfaces/api/amr/{operácia}; <<#EAF3FF>>

switch (Výsledok?)
case (2xx a success)
  :Zalogovať úspech; <<#EEF2F7>>
  :Výsledok OK; <<#E5F6ED>>
case (401)
  :Chyba autentifikácie,\nbez opakovania; <<#FDEBED>>
  :Zalogovať chybu; <<#EEF2F7>>
case (Iná chyba / timeout / sieť)
  :Volanie zlyhalo; <<#FDEBED>>
  :Zalogovať chybu; <<#EEF2F7>>
endswitch
stop
@enduml
