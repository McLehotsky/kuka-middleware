@startuml
skinparam shadowing false
skinparam roundCorner 9
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontColor #182338
skinparam defaultFontSize 16
skinparam titleFontSize 26
skinparam titleFontColor #182338
skinparam ArrowColor #46566D
skinparam ArrowFontColor #26364D
skinparam ArrowFontSize 14
skinparam ActivityBorderColor #7B8798
skinparam ActivityBackgroundColor #F9FBFE
skinparam ActivityDiamondBackgroundColor #F1EDFA
skinparam ActivityDiamondBorderColor #A197C4
skinparam ActivityDiamondFontSize 15
skinparam ActivityStartColor #26364D
skinparam ActivityEndColor #26364D
skinparam ActivityBarColor #46566D

title UC1 Zadať misiu <U+2013> realizácia

start
:Klient: POST /api/missions;
switch (Kontrola požiadavky?)
case (neplatný API kľúč)
  :Technický log; <<#EEF2F7>>
  :401 Unauthorized; <<#FDEBED>>
  stop
case (neplatný vstup)
  :AuditLog; <<#EEF2F7>>
  :400 Bad Request; <<#FDEBED>>
  stop
case (OK)
  :Uložiť misiu Created + história; <<#FFF5DA>>
  :submitMission; <<#EAF3FF>>
  if (KUKA FM prijala?) then (áno)
    :Submitted + história; <<#FFF5DA>>
    :AuditLog; <<#EEF2F7>>
    :201 Created + ID misie; <<#E5F6ED>>
  else (nie)
    :Failed + chyba; <<#FFF5DA>>
    :AuditLog; <<#EEF2F7>>
    :502 + missionId; <<#FDEBED>>
  endif
  stop
endswitch
@enduml
