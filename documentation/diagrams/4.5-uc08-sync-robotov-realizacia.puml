@startuml
skinparam shadowing false
skinparam roundCorner 9
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Segoe UI
skinparam defaultFontColor #182338
skinparam defaultFontSize 16
skinparam titleFontSize 26
skinparam titleFontColor #182338
skinparam ArrowColor #46566D
skinparam ArrowFontColor #26364D
skinparam ArrowFontSize 14
skinparam ActivityBorderColor #7B8798
skinparam ActivityBackgroundColor #F9FBFE
skinparam ActivityDiamondBackgroundColor #F1EDFA
skinparam ActivityDiamondBorderColor #A197C4
skinparam ActivityDiamondFontSize 15
skinparam ActivityStartColor #26364D
skinparam ActivityEndColor #26364D
skinparam ActivityBarColor #46566D

title UC7 Synchronizácia robotov <U+2013> realizácia

start
:Štart API, potom každých 5 s;
:robotQuery; <<#EAF3FF>>
if (Volanie OK?) then (nie)
  :Zalogovať chybu, bez zmien; <<#FDEBED>>
  stop
else (áno)
endif
while (Ďalší robot?) is (áno)
  if (Má robotId a známy stav?) then (áno)
    if (Nový robot?) then (áno)
      :Vložiť robota; <<#FFF5DA>>
    else (nie)
    endif
    :Aktualizovať stav, batériu, uzol\nBatéria ≤ 1 → × 100; <<#FFF5DA>>
    if (Offline?) then (nie)
      :LastSeenAt = teraz; <<#FFF5DA>>
    else (áno)
      :Ponechať poslednú batériu a uzol,\nak ich KUKA FM neposlala;
    endif
  else (nie)
    :Varovanie, robot preskočený; <<#EEF2F7>>
  endif
endwhile (nie)
:Uložiť všetko naraz; <<#FFF5DA>>
:Roboty aktuálne; <<#E5F6ED>>
stop
legend right
  <b>Stav KUKA → stav robota</b>
  | 3 | Available |
  | 1, 4, 5, 6 | Busy |
  | 2, 7 | Offline |
endlegend
@enduml
