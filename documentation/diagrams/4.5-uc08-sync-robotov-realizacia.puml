|Middleware|
start
:Štart API, potom každých 5 s;
|KUKA FM|
:robotQuery; <<#EAF3FF>>
|Middleware|
if (Volanie OK?) then (nie)
  :Zalogovať chybu, bez zmien; <<#FDEBED>>
  stop
else (áno)
endif
while (Ďalší robot?) is (áno)
  if (Má robotId a známy stav?) then (nie)
    :Varovanie, robot preskočený; <<#EEF2F7>>
  else (áno)
    if (Nový robot?) then (áno)
      :Vložiť robota; <<#FFF5DA>>
    else (nie)
    endif
    :Aktualizovať stav, batériu, uzol\nBatéria ≤ 1 → × 100; <<#FFF5DA>>
    if (Offline?) then (áno)
      :Ponechať batériu a uzol\nak ich KUKA FM neposlala; <<#FFF5DA>>
    else (nie)
      :LastSeenAt = teraz; <<#FFF5DA>>
    endif
  endif
endwhile (nie)
:Uložiť všetko naraz; <<#FFF5DA>>
:Roboty aktuálne; <<#E5F6ED>>
stop
