@startuml
|Middleware|
start
:Štart API a potom tick plánovača
(každých 5 s, Sync:RobotIntervalSeconds);
:Volanie KUKA FM (4.0);
|KUKA FM|
:robotQuery;
|Middleware|
if (Výsledok OK?) then (nie)
  :Zalogovať chybu
  (stav robotov sa nemení);
  stop
else (áno)
endif
:Načítať roboty z DB;
while (Ďalší robot v odpovedi?) is (áno)
  if (Robot má robotId?) then (nie)
    :Zalogovať varovanie
    (robot preskočený);
  else (áno)
  :Namapovať status KUKA FM:
  3 → Available
  1 / 4 / 5 / 6 → Busy
  2 / 7 → Offline;
  if (Známy status?) then (nie)
    :Zalogovať varovanie
    (robot bez zmeny);
  else (áno)
    if (Robot existuje v DB?) then (nie)
      :Vložiť nového robota
      (KukaRobotId);
    else (áno)
    endif
    :Aktualizovať stav, UpdatedAt;
    :Batéria: hodnota ≤ 1 ako podiel × 100,
    inak percentá (0–100);
    :Aktualizovať aktuálny uzol;
    if (Stav Offline?) then (áno)
      :Ponechať poslednú batériu a uzol,
      ak ich KUKA FM neposlal;
    else (nie)
      :Nastaviť LastSeenAt;
    endif
  endif
  endif
endwhile (nie)
:Uložiť zmeny jedným SaveChanges;
note right
  Roboty, ktoré v odpovedi chýbajú,
  ostávajú bez zmeny.
end note
stop
@enduml
