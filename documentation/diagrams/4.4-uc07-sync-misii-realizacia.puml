@startuml
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Segoe UI
skinparam defaultFontColor #14243A
skinparam defaultFontSize 16
skinparam titleFontSize 28
skinparam titleFontColor #14243A
skinparam roundCorner 9
skinparam ArrowColor #607590
skinparam ArrowFontColor #415570
skinparam ActivityBorderColor #A1B0C2
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityDiamondBackgroundColor #F1EDFA
skinparam ActivityDiamondBorderColor #A197C4
skinparam ActivityStartColor #14243A
skinparam ActivityEndColor #14243A
skinparam SwimlaneBorderColor #D7E1ED
skinparam SwimlaneTitleFontSize 17
skinparam SwimlaneTitleFontStyle bold

title 4.4 UC5 Synchronizácia misií <U+2013> realizácia
|#FFFFFF|Middleware|
|#F7FAFF|KUKA FM|
|Middleware|
start
:Štart API, potom každých 5 s;
:Načítať aktívne misie\nSubmitted · InProgress · Cancelling;
if (Aktívne misie?) then (nie)
  stop
else (áno)
endif
repeat
  |KUKA FM|
  :jobQuery\njobCode = kód misie; <<#EAF3FF>>
  |Middleware|
  if (Volanie OK?) then (nie)
    :Zalogovať chybu, nič neuložiť; <<#FDEBED>>
    stop
  else (áno)
  endif
  :Nastaviť LastSyncedAt; <<#FFF5DA>>
  if (Záznam pre misiu?) then (nie)
    :Varovanie, stav bez zmeny; <<#EEF2F7>>
  else (áno)
    :Doplniť robota, ak chýba; <<#FFF5DA>>
    switch (Povolená zmena stavu?)
    case (áno)
      :Nový stav + história\nFinishedAt pri koncovom stave; <<#FFF5DA>>
    case (bez zmeny)
    case (neznámy kód)
      :Varovanie, neznámy kód; <<#EEF2F7>>
    endswitch
  endif
repeat while (Ďalšia misia?) is (áno) not (nie)
:Uložiť v jednej transakcii; <<#FFF5DA>>
if (Konflikt pri uložení?) then (áno)
  :Zalogovať konflikt, nič neuložiť; <<#EEF2F7>>
else (nie)
  :Zmeny uložené; <<#E5F6ED>>
endif
:Čakať na ďalší cyklus;
stop
legend right
  <b>Stav KUKA → stav misie</b>
  | 10 | Submitted |
  | 20, 25, 50 | InProgress |
  | 28 | Cancelling |
  | 30, 35 | Completed |
  | 31 | Cancelled |
  | 60 | Failed |

  <b>Legenda farieb</b>
  |<#EAF3FF>    | Volanie KUKA FM / Docker |
  |<#E5F6ED>    | Úspech |
  |<#FDEBED>    | Chyba / odmietnutie |
  |<#FFF5DA>    | Zápis do databázy |
  |<#EEF2F7>    | Log / audit |
  |<color:#8064A9>◆</color>| Rozhodnutie |
  |<#FFFFFF>    | Bežný krok |
endlegend
@enduml
