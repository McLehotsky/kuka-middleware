{
  "ConnectionStrings": {
    "Default": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341"
        }
      }
    ]
  },
  "KukaFm": {
    "BaseUrl": "https://kukafm.its.fei",
    "AccessToken": "",
    "OrgId": "UNIVERSAL",
    "CancelMode": "FORCE",
    "TimeoutSeconds": 10,
    "WaitMillis": 5000
  },
  "Sync": {
    "RobotIntervalSeconds": 5,
    "MissionIntervalSeconds": 5
  },
  "AllowedHosts": "*"
}
